[
  {
    "id": "TC001",
    "title": "Send notification to All Parents with preview recipient count",
    "description": "Verifies an authenticated school admin can compose a notification for All Parents, preview recipient count, and send successfully.",
    "category": "School Notification Sending",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the Login button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/school\""
      },
      {
        "type": "action",
        "description": "Click on \"Notifications\" in the navigation menu"
      },
      {
        "type": "action",
        "description": "Click on \"Send New\" or \"Create Notification\""
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/school/notifications/create\""
      }
    ]
  },
  {
    "id": "TC002",
    "title": "All Parents preview shows recipient count before sending",
    "description": "Verifies preview action displays a visible recipient count for All Parents after entering title and message.",
    "category": "School Notification Sending",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the Login button"
      },
      {
        "type": "action",
        "description": "Navigate to /school/notifications/create"
      },
      {
        "type": "action",
        "description": "Type \"Trip Reminder\" into the notification title field"
      },
      {
        "type": "action",
        "description": "Type \"Please ensure your child is ready 10 minutes before pickup.\" into the notification message field"
      },
      {
        "type": "action",
        "description": "Select \"All Parents\" from the recipient type dropdown"
      },
      {
        "type": "action",
        "description": "Click Preview to see recipient count"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Recipient\" is visible"
      }
    ]
  },
  {
    "id": "TC003",
