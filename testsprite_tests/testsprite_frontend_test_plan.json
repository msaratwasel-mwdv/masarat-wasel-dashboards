  {
    "id": "TC009",
    "title": "Persisted student boarded notification appears in school notifications list after login",
    "description": "Verifies that an authenticated school user can see a newly persisted student boarding notification in the notifications list UI.",
    "category": "Guardian Notification for Student Boarding",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email/username field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Log in\" button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/school\""
      },
      {
        "type": "action",
        "description": "Click on the \"Notifications\" navigation item"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/school/notifications\""
      },
      {
        "type": "assertion",
        "description": "Verify text \"student_boarded\" is visible"
      }
    ]
  },
